# ModemCheck Cloud API v2 - Environment Configuration
# ==============================================================================
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Generate secure secrets (see commands below)
# 3. Update all values marked with CHANGE_THIS or REQUIRED
# 4. Set restrictive permissions:  chmod 600 .env
# 5. NEVER commit .env to version control
# ==============================================================================

# ==============================================================================
# CRITICAL SECRETS (REQUIRED - Generate using commands below)
# ==============================================================================

# Database password for PostgreSQL
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_DB_PASSWORD=CHANGE_THIS_REQUIRED

# Application secret key for session encryption and signing
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_THIS_REQUIRED

# CSRF token secret key for cross-site request forgery protection
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
CSRF_SECRET_KEY=CHANGE_THIS_REQUIRED

# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================
APP_ENV=production  # production, development, or test
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4  # Number of Gunicorn workers (2 * CPU cores + 1)

# Database (PostgreSQL)
# NOTE: Uses POSTGRES_DB_PASSWORD from above - do not change the variable reference
DATABASE_URL=postgresql+asyncpg://modemcheck:${POSTGRES_DB_PASSWORD}@postgres:5432/modemcheck

# Connection Pool Settings
# Total connections = (DB_POOL_SIZE + DB_MAX_OVERFLOW) × WORKERS
# Default: (25 + 10) × 4 workers = 140 connections
# PostgreSQL max_connections set to 200 (140 app + 60 buffer)
DB_POOL_SIZE=25           # Connections per worker
DB_MAX_OVERFLOW=10        # Extra connections during bursts
DB_POOL_RECYCLE=3600      # Recycle connections after 1 hour
DB_ECHO=false             # Set to true for SQL query debugging

# Redis
REDIS_HOST=redis-v2
REDIS_PORT=6379
REDIS_DB=0
# Redis password for authentication (REQUIRED for production security)
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=CHANGE_THIS_REQUIRED
REDIS_SSL=false

# Session Management
SESSION_TTL=3600  # 1 hour in seconds
SESSION_COOKIE_NAME=modemcheck_session
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=strict

# Account Security
MAX_FAILED_LOGINS=5
ACCOUNT_LOCKOUT_DURATION=1800  # 30 minutes in seconds
MIN_PASSWORD_LENGTH=12

# ==============================================================================
# CORS CONFIGURATION (REQUIRED)
# ==============================================================================
# Comma-separated list of allowed origins for cross-origin requests
# SECURITY WARNING: Never use * in production! Specify exact domains.
#
# Examples:
#   Production:  ALLOWED_ORIGINS=https://modemcheck.example.com,https://admin.example.com
#   Development: ALLOWED_ORIGINS=http://localhost:23890,http://localhost:22557
#   Testing:     ALLOWED_ORIGINS=http://localhost:23894
ALLOWED_ORIGINS=CHANGE_THIS_REQUIRED

# File Upload Limits
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
MAX_BULK_UPLOAD_FILES=1000
MAX_BULK_DOWNLOAD_SIZE=104857600  # 100MB in bytes

# Common Passwords File
COMMON_PASSWORDS_FILE=/app/common_passwords.txt

# ==============================================================================
# RATE LIMITING
# ==============================================================================
# Rate limits are configurable per endpoint to prevent abuse and ensure fair usage.
# Format: "count/period" where period can be: second, minute, hour, day
# Examples: "60/minute", "300/second", "1000/hour"
#
# These limits are enforced at the application level. For production, consider
# additional rate limiting at the nginx reverse proxy level.

# Upload endpoint (client data uploads)
UPLOAD_RATE_LIMIT=60/minute

# Authentication endpoints (login, logout)
AUTH_RATE_LIMIT=30/minute

# API query endpoints (read operations)
API_QUERY_RATE_LIMIT=300/second

# Admin endpoints (user management, API keys)
API_ADMIN_RATE_LIMIT=100/minute

# Data management endpoints (bulk upload/download)
API_DATA_MGMT_RATE_LIMIT=50/minute

# Config sync endpoints (client configuration management)
CONFIG_PREFLIGHT_RATE_LIMIT=10/hour
CONFIG_SYNC_RATE_LIMIT=15/hour

# ==============================================================================
# SECURITY BEST PRACTICES
# ==============================================================================
# 1. NEVER commit .env to version control (already in .gitignore)
# 2. Use different secrets for development, staging, and production
# 3. Rotate secrets every 90 days (mark rotation dates in .env)
# 4. Back up .env securely (password manager, secrets vault)
# 5. Restrict file permissions: chmod 600 .env
# 6. Monitor for secrets in logs (secrets should never appear in logs)
#
# When rotating secrets:
#   - Generate new values using the commands above
#   - Update .env with new secrets
#   - Restart containers: docker-compose down && docker-compose up -d
#   - All active sessions will be invalidated (users must re-login)
#   - Force password changes after SECRET_KEY rotation
#
# Credential rotation checklist:
#   [ ] POSTGRES_DB_PASSWORD rotated (last: YYYY-MM-DD, next: YYYY-MM-DD)
#   [ ] REDIS_PASSWORD rotated (last: YYYY-MM-DD, next: YYYY-MM-DD)
#   [ ] SECRET_KEY rotated (last: YYYY-MM-DD, next: YYYY-MM-DD)
#   [ ] CSRF_SECRET_KEY rotated (last: YYYY-MM-DD, next: YYYY-MM-DD)
#   [ ] All sessions invalidated (Redis flushed)
#   [ ] Users notified of password change requirement
