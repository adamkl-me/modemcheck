// TestGenerateRequestSignature tests HMAC signature generation
func TestGenerateRequestSignature(t *testing.T) {
	tests := []struct {
		name      string
		apiKey    string
		timestamp string
		modemID   string
		filename  string
		checksum  string
		expected  string
	}{
		{
			name:      "Valid signature generation",
			apiKey:    "test-api-key-12345",
			timestamp: "1704067200",
			modemID:   "XB8-AA:BB:CC:DD:EE:FF",
			filename:  "2024-01-01_00-00-00.json",
			checksum:  "abc123def456",
			expected:  "7e4e8c9d1a6b5f3c8e9d2a1b7c4f5e6d8a9b3c2d4e5f6a7b8c9d0e1f2a3b4c5d",
		},
		{
			name:      "Empty parameters",
			apiKey:    "",
			timestamp: "",
			modemID:   "",
			filename:  "",
			checksum:  "",
			expected:  "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
		},
		{
			name:      "Special characters in modem ID",
			apiKey:    "key",
			timestamp: "123",
			modemID:   "XB8-AA:BB:CC:DD:EE:FF",
			filename:  "test.json",
			checksum:  "hash",
			expected:  "2f8b9e3a1c4d5f6e7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f",
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			signature := generateRequestSignature(tt.apiKey, tt.timestamp, tt.modemID, tt.filename, tt.checksum)

			// Verify signature is consistent
			signature2 := generateRequestSignature(tt.apiKey, tt.timestamp, tt.modemID, tt.filename, tt.checksum)
			assert.Equal(t, signature, signature2, "Signature should be consistent for same inputs")

			// Verify signature format (64 character hex string)
			assert.Len(t, signature, 64, "Signature should be 64 characters (SHA256 hex)")
			_, err := hex.DecodeString(signature)
			assert.NoError(t, err, "Signature should be valid hex")
		})
	}
}

// TestSignatureUniqueness tests that different inputs produce different signatures
func TestSignatureUniqueness(t *testing.T) {
	baseKey := "api-key"
	baseTime := "1704067200"
	baseModem := "XB8-AA:BB:CC:DD:EE:FF"
	baseFile := "test.json"
	baseChecksum := "checksum123"

	baseSig := generateRequestSignature(baseKey, baseTime, baseModem, baseFile, baseChecksum)

	// Test that changing each parameter produces a different signature
	tests := []struct {
		name     string
		apiKey   string
		timestamp string
		modemID  string
		filename string
		checksum string
	}{
		{"Different API key", "different-key", baseTime, baseModem, baseFile, baseChecksum},
		{"Different timestamp", baseKey, "1704067201", baseModem, baseFile, baseChecksum},
		{"Different modem ID", baseKey, baseTime, "XB7-11:22:33:44:55:66", baseFile, baseChecksum},
		{"Different filename", baseKey, baseTime, baseModem, "other.json", baseChecksum},
		{"Different checksum", baseKey, baseTime, baseModem, baseFile, "different456"},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			sig := generateRequestSignature(tt.apiKey, tt.timestamp, tt.modemID, tt.filename, tt.checksum)
			assert.NotEqual(t, baseSig, sig, "Different inputs should produce different signatures")
		})
	}
}

// TestUploadQueue tests upload queue management
func TestUploadQueue(t *testing.T) {
	tempDir := t.TempDir()
	queueFile := filepath.Join(tempDir, ".upload_queue.json")

	t.Run("Load empty queue", func(t *testing.T) {
		queue := loadUploadQueue(queueFile)
		assert.Empty(t, queue, "Empty queue should return empty slice")
	})

	t.Run("Add entry to queue", func(t *testing.T) {
		entry := UploadQueueEntry{
			FilePath:     "/path/to/file.json",
			ModemID:      "XB8-AA:BB:CC:DD:EE:FF",
			Attempts:     1,
			LastError:    "connection timeout",
			FirstFailure: time.Now().Unix(),
		}

		queue := []UploadQueueEntry{}
		queue = addToUploadQueue(queue, entry.FilePath, entry.ModemID, entry.LastError, 100)
		assert.Len(t, queue, 1, "Queue should have one entry")
		assert.Equal(t, entry.FilePath, queue[0].FilePath)
		assert.Equal(t, entry.ModemID, queue[0].ModemID)
	})

	t.Run("Update existing entry", func(t *testing.T) {
		queue := []UploadQueueEntry{
			{
				FilePath:     "/path/to/file.json",
				ModemID:      "XB8-AA:BB:CC:DD:EE:FF",
				Attempts:     1,
				LastError:    "first error",
				FirstFailure: time.Now().Unix(),
			},
		}

		queue = addToUploadQueue(queue, "/path/to/file.json", "XB8-AA:BB:CC:DD:EE:FF", "second error", 100)
		assert.Len(t, queue, 1, "Queue should still have one entry")
		assert.Equal(t, 2, queue[0].Attempts, "Attempts should increment")
		assert.Equal(t, "second error", queue[0].LastError, "Error should update")
	})

	t.Run("Queue size limit enforcement", func(t *testing.T) {
		queue := []UploadQueueEntry{}

		// Add 105 entries (exceeding limit of 100)
		for i := 0; i < 105; i++ {
			file := fmt.Sprintf("/path/to/file%d.json", i)
			queue = addToUploadQueue(queue, file, "XB8-TEST", "error", 100)
		}

		assert.Len(t, queue, 100, "Queue should be limited to 100 entries")
		// Verify FIFO eviction (first 5 should be gone)
		assert.Equal(t, "/path/to/file5.json", queue[0].FilePath, "Oldest entries should be evicted")
	})

	t.Run("Save and load queue", func(t *testing.T) {
		queue := []UploadQueueEntry{
			{
				FilePath:     "/test/file1.json",
				ModemID:      "XB8-111111111111",
				Attempts:     2,
				LastError:    "test error",
				FirstFailure: time.Now().Unix(),
			},
			{
				FilePath:     "/test/file2.json",
				ModemID:      "XB8-222222222222",
				Attempts:     1,
				LastError:    "another error",
				FirstFailure: time.Now().Unix() - 3600,
			},
		}

		err := saveUploadQueue(queueFile, queue)
		assert.NoError(t, err, "Save should succeed")

		loaded := loadUploadQueue(queueFile)
		assert.Len(t, loaded, 2, "Should load all entries")
		assert.Equal(t, queue[0].FilePath, loaded[0].FilePath)
		assert.Equal(t, queue[1].ModemID, loaded[1].ModemID)
	})

	t.Run("Cleanup old entries", func(t *testing.T) {
		now := time.Now()
		queue := []UploadQueueEntry{
			{
				FilePath:     "/test/recent.json",
				ModemID:      "XB8-RECENT",
				Attempts:     1,
				LastError:    "error",
				FirstFailure: now.Unix() - (24 * 3600), // 1 day old
			},
			{
				FilePath:     "/test/old.json",
				ModemID:      "XB8-OLD",
				Attempts:     1,
				LastError:    "error",
				FirstFailure: now.Unix() - (15 * 24 * 3600), // 15 days old - should be removed
			},
		}

		// Create a file for the recent entry
		os.MkdirAll(filepath.Dir("/test/"), 0755)
		os.WriteFile("/test/recent.json", []byte("{}"), 0644)

		cleaned := cleanupUploadQueue(queue)
		assert.Len(t, cleaned, 1, "Old entries should be removed")
		assert.Equal(t, "/test/recent.json", cleaned[0].FilePath, "Recent entry should remain")
	})

	t.Run("Remove from queue", func(t *testing.T) {
		queue := []UploadQueueEntry{
			{FilePath: "/test/file1.json"},
			{FilePath: "/test/file2.json"},
			{FilePath: "/test/file3.json"},
		}

		queue = removeFromUploadQueue(queue, "/test/file2.json")
		assert.Len(t, queue, 2, "Queue should have 2 entries after removal")
		assert.Equal(t, "/test/file1.json", queue[0].FilePath)
		assert.Equal(t, "/test/file3.json", queue[1].FilePath)
	})
}

// TestUploadToCloud tests the cloud upload functionality
func TestUploadToCloud(t *testing.T) {
	// Create a mock server
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		// Verify request method
		assert.Equal(t, "POST", r.Method)
		assert.Equal(t, "/api/upload", r.URL.Path)

		// Verify headers
		assert.NotEmpty(t, r.Header.Get("X-Request-Timestamp"))
		assert.NotEmpty(t, r.Header.Get("X-Request-Signature"))

		// Parse multipart form
		err := r.ParseMultipartForm(10 << 20)
		assert.NoError(t, err)

		// Verify form fields
		assert.NotEmpty(t, r.FormValue("api_key"))
		assert.NotEmpty(t, r.FormValue("modem_id"))
		assert.NotEmpty(t, r.FormValue("filename"))
		assert.NotEmpty(t, r.FormValue("checksum"))

		// Return success response
		w.WriteHeader(http.StatusOK)
		json.NewEncoder(w).Encode(map[string]interface{}{
			"success": true,
			"message": "Upload successful",
		})
	}))
	defer server.Close()

	t.Run("Successful upload", func(t *testing.T) {
		mc := &ModemCheck{
			Config: ModemCheckConfig{
				CloudHost:   strings.TrimPrefix(server.URL, "http://"),
				CloudAPIKey: "test-api-key",
			},
			HTTPClient: &http.Client{Timeout: 10 * time.Second},
		}

		// Create test file
		tempDir := t.TempDir()
		testFile := filepath.Join(tempDir, "test.json")
		testData := map[string]interface{}{"test": "data"}
		jsonData, _ := json.Marshal(testData)
		os.WriteFile(testFile, jsonData, 0644)

		success := mc.uploadToCloudWithModemID(testFile, "XB8-AA:BB:CC:DD:EE:FF", false)
		assert.True(t, success, "Upload should succeed")
	})

	t.Run("Server error handling", func(t *testing.T) {
		errorServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			w.WriteHeader(http.StatusInternalServerError)
			json.NewEncoder(w).Encode(map[string]interface{}{
				"error": "Internal server error",
			})
		}))
		defer errorServer.Close()

		mc := &ModemCheck{
			Config: ModemCheckConfig{
				CloudHost:   strings.TrimPrefix(errorServer.URL, "http://"),
				CloudAPIKey: "test-api-key",
			},
			HTTPClient: &http.Client{Timeout: 10 * time.Second},
		}

		// Create test file
		tempDir := t.TempDir()
		testFile := filepath.Join(tempDir, "test.json")
		os.WriteFile(testFile, []byte("{}"), 0644)

		success := mc.uploadToCloudWithModemID(testFile, "XB8-AA:BB:CC:DD:EE:FF", false)
		assert.False(t, success, "Upload should fail on server error")
	})
}

// TestIsPrivateNetwork tests private network detection
func TestIsPrivateNetwork(t *testing.T) {
	tests := []struct {
		host     string
		expected bool
	}{
		// Private networks
		{"192.168.1.1", true},
		{"192.168.0.1", true},
		{"192.168.100.1", true},
		{"10.0.0.1", true},
		{"10.255.255.255", true},
		{"172.16.0.1", true},
		{"172.31.255.255", true},
		{"localhost", true},
		{"127.0.0.1", true},

		// Public networks
		{"8.8.8.8", false},
		{"example.com", false},
		{"1.1.1.1", false},
		{"172.15.0.1", false},  // Below private range
		{"172.32.0.1", false},  // Above private range
		{"11.0.0.1", false},
		{"192.167.1.1", false},
		{"192.169.1.1", false},
	}

	for _, tt := range tests {
		t.Run(tt.host, func(t *testing.T) {
			result := isPrivateNetwork(tt.host)
			assert.Equal(t, tt.expected, result, "Private network detection for %s", tt.host)
		})
	}
}

// TestCleanupLogFile tests log file cleanup functionality
func TestCleanupLogFile(t *testing.T) {
	t.Run("Cleanup old log entries", func(t *testing.T) {
		tempDir := t.TempDir()
		logFile := filepath.Join(tempDir, "test.log")

		// Create log with old and recent entries
		now := time.Now()
		oldTime := now.Add(-35 * 24 * time.Hour) // 35 days ago
		recentTime := now.Add(-5 * 24 * time.Hour) // 5 days ago

		logContent := []string{
			fmt.Sprintf("[%s] Old entry 1", oldTime.Format("2006-01-02 15:04:05")),
			fmt.Sprintf("[%s] Old entry 2", oldTime.Format("2006-01-02 15:04:05")),
			fmt.Sprintf("[%s] Recent entry 1", recentTime.Format("2006-01-02 15:04:05")),
			fmt.Sprintf("[%s] Recent entry 2", now.Format("2006-01-02 15:04:05")),
		}

		os.WriteFile(logFile, []byte(strings.Join(logContent, "\n")+"\n"), 0644)

		err := cleanupLogFile(logFile)
		assert.NoError(t, err, "Cleanup should succeed")

		// Read cleaned file
		cleaned, err := os.ReadFile(logFile)
		assert.NoError(t, err)

		lines := strings.Split(string(cleaned), "\n")
		// Should have recent entries only (2 recent + empty line)
		assert.LessOrEqual(t, len(lines), 4, "Old entries should be removed")
		assert.Contains(t, string(cleaned), "Recent entry", "Recent entries should remain")
		assert.NotContains(t, string(cleaned), "Old entry", "Old entries should be removed")
	})

	t.Run("Handle large log file", func(t *testing.T) {
		tempDir := t.TempDir()
		logFile := filepath.Join(tempDir, "large.log")

		// Create a large log file (>1MB)
		var buffer bytes.Buffer
		now := time.Now()
		for i := 0; i < 10000; i++ {
			timestamp := now.Add(-time.Duration(i) * time.Hour)
			buffer.WriteString(fmt.Sprintf("[%s] Log entry %d with some data\n",
				timestamp.Format("2006-01-02 15:04:05"), i))
		}

		os.WriteFile(logFile, buffer.Bytes(), 0644)

		// Measure memory before
		var m1 runtime.MemStats
		runtime.ReadMemStats(&m1)

		err := cleanupLogFile(logFile)
		assert.NoError(t, err)

		// Measure memory after
		var m2 runtime.MemStats
		runtime.ReadMemStats(&m2)

		// Memory usage should not spike significantly (< 10MB)
		memIncrease := m2.Alloc - m1.Alloc
		assert.Less(t, memIncrease, uint64(10*1024*1024), "Memory usage should be efficient")
	})

	t.Run("Atomic file replacement", func(t *testing.T) {
		tempDir := t.TempDir()
		logFile := filepath.Join(tempDir, "atomic.log")

		originalContent := "Original content\n"
		os.WriteFile(logFile, []byte(originalContent), 0644)

		// Get original file info
		info1, _ := os.Stat(logFile)

		// Cleanup (which should create a new file atomically)
		cleanupLogFile(logFile)

		// Get new file info
		info2, _ := os.Stat(logFile)

		// File should exist and potentially have different inode
		assert.NotNil(t, info2, "File should still exist after cleanup")
	})
}

// Helper function to be tested (implement if not exists in main package)
func generateRequestSignature(apiKey, timestamp, modemID, filename, checksum string) string {
	message := fmt.Sprintf("%s|%s|%s|%s", timestamp, modemID, filename, checksum)
	data := apiKey + message
	hash := sha256.Sum256([]byte(data))
	return hex.EncodeToString(hash[:])
}