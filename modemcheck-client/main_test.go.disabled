func TestConfigLoading(t *testing.T) {
	tests := []struct {
		name        string
		configJSON  string
		expectError bool
		validate    func(*testing.T, *Config)
	}{
		{
			name: "Valid complete config",
			configJSON: `{
				"Username": "testuser",
				"Password": "testpass",
				"CloudAPIEnabled": true,
				"CloudAPIURL": "https://api.test.com",
				"CloudAPIKey": "test-key-123",
				"SpeedTestInterval": 5,
				"UpdateChannel": "stable"
			}`,
			expectError: false,
			validate: func(t *testing.T, cfg *Config) {
				assert.Equal(t, "testuser", cfg.Username)
				assert.Equal(t, "testpass", cfg.Password)
				assert.True(t, cfg.CloudAPIEnabled)
				assert.Equal(t, "https://api.test.com", cfg.CloudAPIURL)
				assert.Equal(t, "test-key-123", cfg.CloudAPIKey)
				assert.Equal(t, 5, cfg.SpeedTestInterval)
				assert.Equal(t, "stable", cfg.UpdateChannel)
			},
		},
		{
			name: "Minimal config",
			configJSON: `{
				"Username": "admin",
				"Password": "admin"
			}`,
			expectError: false,
			validate: func(t *testing.T, cfg *Config) {
				assert.Equal(t, "admin", cfg.Username)
				assert.Equal(t, "admin", cfg.Password)
				assert.False(t, cfg.CloudAPIEnabled)
				assert.Equal(t, 1, cfg.SpeedTestInterval) // Default
			},
		},
		{
			name: "Invalid update channel",
			configJSON: `{
				"Username": "admin",
				"Password": "admin",
				"UpdateChannel": "invalid"
			}`,
			expectError: false,
			validate: func(t *testing.T, cfg *Config) {
				// Should default to stable for invalid channel
				assert.Equal(t, "stable", cfg.UpdateChannel)
			},
		},
		{
			name:        "Malformed JSON",
			configJSON:  `{"Username": "admin", "Password": `,
			expectError: true,
		},
		{
			name:        "Empty config",
			configJSON:  `{}`,
			expectError: false,
			validate: func(t *testing.T, cfg *Config) {
				// Should have defaults
				assert.Equal(t, "", cfg.Username)
				assert.Equal(t, "", cfg.Password)
				assert.Equal(t, 1, cfg.SpeedTestInterval)
			},
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			// Create temp config file
			tmpDir := t.TempDir()
			configPath := filepath.Join(tmpDir, "config.json")

			err := os.WriteFile(configPath, []byte(tt.configJSON), 0644)
			require.NoError(t, err)

			// Load config
			cfg, err := loadConfig(configPath)

			if tt.expectError {
				assert.Error(t, err)
			} else {
				assert.NoError(t, err)
				if tt.validate != nil {
					tt.validate(t, cfg)
				}
			}
		})
	}
}

func TestResultsDirectoryCreation(t *testing.T) {
	tmpDir := t.TempDir()

	tests := []struct {
		name        string
		modemMAC    string
		modemType   string
		expectedDir string
	}{
		{
			name:        "Standard MAC format",
			modemMAC:    "AA:BB:CC:DD:EE:FF",
			modemType:   "XB8",
			expectedDir: "ModemCheck-Results/XB8-AABBCCDDEEFF",
		},
		{
			name:        "Lowercase MAC",
			modemMAC:    "aa:bb:cc:dd:ee:ff",
			modemType:   "CM2000",
			expectedDir: "ModemCheck-Results/CM2000-aabbccddeeff",
		},
		{
			name:        "MAC with dashes",
			modemMAC:    "AA-BB-CC-DD-EE-FF",
			modemType:   "DM1000",
			expectedDir: "ModemCheck-Results/DM1000-AA-BB-CC-DD-EE-FF",
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			// Change to temp directory
			originalWd, _ := os.Getwd()
			os.Chdir(tmpDir)
			defer os.Chdir(originalWd)

			// Create results directory
			dir := createResultsDirectory(tt.modemType, tt.modemMAC)

			// Verify directory was created
			expectedPath := filepath.Join(tmpDir, tt.expectedDir)
			assert.DirExists(t, expectedPath)
			assert.Equal(t, expectedPath, dir)
		})
	}
}

func TestJSONOutput(t *testing.T) {
	tests := []struct {
		name     string
		data     *ModemData
		validate func(*testing.T, map[string]interface{})
	}{
		{
			name: "Complete modem data",
			data: &ModemData{
				CheckTime:   1699900000,
				Uptime:      "2 days 3:45:12",
				Firmware:    "v1.2.3",
				SystemTime:  "2023-11-13 12:00:00",
				Downstream:  []DownstreamChannel{{Channel: 1, PowerLevel: 5.5}},
				Upstream:    []UpstreamChannel{{Channel: 1, PowerLevel: 45.5}},
				FECSummary:  FECData{Corrected: 100, Uncorrectable: 5},
				OFDMSummary: OFDMData{PlcPower: -10.5},
				SpeedTestResult: SpeedTestData{
					Download: 950.5,
					Upload:   40.2,
				},
				PingTestResult: PingTestResult{
					GoogleDNS:     PingData{AvgLatency: "5.2", PacketLoss: "0"},
					CloudflareDNS: PingData{AvgLatency: "3.1", PacketLoss: "0"},
				},
				PublicIPInfo: PublicIPData{
					IP:  "1.2.3.4",
					ISP: "Test ISP",
					ASN: "AS12345",
				},
				ClientVersion: "6.0.0",
				ClientOS:      "linux",
				ClientArch:    "amd64",
			},
			validate: func(t *testing.T, result map[string]interface{}) {
				assert.Equal(t, float64(1699900000), result["check_time"])
				assert.Equal(t, "2 days 3:45:12", result["uptime"])
				assert.Equal(t, "v1.2.3", result["firmware"])
				assert.Equal(t, "6.0.0", result["client_version"])

				// Check nested structures
				speedTest := result["speed_test_result"].(map[string]interface{})
				assert.Equal(t, 950.5, speedTest["download"])
				assert.Equal(t, 40.2, speedTest["upload"])

				publicIP := result["public_ip_info"].(map[string]interface{})
				assert.Equal(t, "1.2.3.4", publicIP["ip"])
				assert.Equal(t, "Test ISP", publicIP["isp"])
			},
		},
		{
			name: "Minimal modem data",
			data: &ModemData{
				CheckTime:     1699900000,
				ClientVersion: "6.0.0",
			},
			validate: func(t *testing.T, result map[string]interface{}) {
				assert.Equal(t, float64(1699900000), result["check_time"])
				assert.Equal(t, "6.0.0", result["client_version"])
			},
		},
		{
			name: "Data with errors",
			data: &ModemData{
				CheckTime:     1699900000,
				ClientVersion: "6.0.0",
				Errors:        []string{"Failed to get downstream", "Speed test failed"},
			},
			validate: func(t *testing.T, result map[string]interface{}) {
				errors := result["errors"].([]interface{})
				assert.Len(t, errors, 2)
				assert.Contains(t, errors, "Failed to get downstream")
				assert.Contains(t, errors, "Speed test failed")
			},
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			// Convert to JSON
			jsonData, err := json.Marshal(tt.data)
			require.NoError(t, err)

			// Parse back to verify
			var result map[string]interface{}
			err = json.Unmarshal(jsonData, &result)
			require.NoError(t, err)

			// Validate
			tt.validate(t, result)
		})
	}
}

func TestLogFileManagement(t *testing.T) {
	tmpDir := t.TempDir()

	t.Run("Log file creation", func(t *testing.T) {
		logPath := filepath.Join(tmpDir, "test.log")

		mc := &ModemCheck{
			logFilePath: logPath,
		}

		// Initialize log file
		logFile, err := os.OpenFile(logPath, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0644)
		require.NoError(t, err)
		mc.logFile = logFile
		defer logFile.Close()

		// Write log entry
		mc.Log("Test log entry")

		// Verify log was written
		content, err := os.ReadFile(logPath)
		require.NoError(t, err)
		assert.Contains(t, string(content), "Test log entry")
	})

	t.Run("Log rotation by size", func(t *testing.T) {
		logPath := filepath.Join(tmpDir, "size-test.log")

		// Create large log file (simulate > 10MB)
		largeContent := make([]byte, 11*1024*1024) // 11MB
		err := os.WriteFile(logPath, largeContent, 0644)
		require.NoError(t, err)

		// Should trigger rotation on next write
		mc := &ModemCheck{
			logFilePath: logPath,
		}

		// Check if rotation would occur
		info, err := os.Stat(logPath)
		require.NoError(t, err)
		assert.Greater(t, info.Size(), int64(10*1024*1024))
	})

	t.Run("Log cleanup old entries", func(t *testing.T) {
		logPath := filepath.Join(tmpDir, "cleanup-test.log")

		// Create log with old and new entries
		now := time.Now()
		oldTime := now.Add(-35 * 24 * time.Hour) // 35 days ago
		newTime := now.Add(-5 * 24 * time.Hour)  // 5 days ago

		logContent := fmt.Sprintf(
			"%s Old entry\n%s New entry\n%s Current entry\n",
			oldTime.Format("2006-01-02 15:04:05"),
			newTime.Format("2006-01-02 15:04:05"),
			now.Format("2006-01-02 15:04:05"),
		)

		err := os.WriteFile(logPath, []byte(logContent), 0644)
		require.NoError(t, err)

		// Cleanup would remove entries > 30 days
		// In actual implementation, cleanupOldLogs() would handle this
	})
}

func TestCloudUpload(t *testing.T) {
	t.Run("Successful upload", func(t *testing.T) {
		// Create test server
		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			// Verify request
			assert.Equal(t, "/api/upload", r.URL.Path)
			assert.Equal(t, "POST", r.Method)

			// Check headers
			assert.NotEmpty(t, r.Header.Get("X-Request-Timestamp"))
			assert.NotEmpty(t, r.Header.Get("X-Request-Signature"))

			// Parse multipart form
			err := r.ParseMultipartForm(10 << 20)
			require.NoError(t, err)

			// Verify form fields
			assert.NotEmpty(t, r.FormValue("api_key"))
			assert.NotEmpty(t, r.FormValue("modem_id"))
			assert.NotEmpty(t, r.FormValue("checksum"))

			// Return success
			w.WriteHeader(http.StatusOK)
			json.NewEncoder(w).Encode(map[string]interface{}{
				"status": "success",
				"id":     "123",
			})
		}))
		defer server.Close()

		// Create test client
		cc := &CloudClient{
			apiURL: server.URL,
			apiKey: "test-key",
			client: http.DefaultClient,
		}

		// Test data
		data := &ModemData{
			CheckTime:     time.Now().Unix(),
			ClientVersion: "6.0.0",
		}

		// Upload
		err := cc.uploadToCloud(data, "XB8-AABBCCDDEEFF", "test.json")
		assert.NoError(t, err)
	})

	t.Run("Upload with retry on failure", func(t *testing.T) {
		attempts := 0

		// Create test server that fails first time
		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			attempts++
			if attempts == 1 {
				w.WriteHeader(http.StatusInternalServerError)
				return
			}
			w.WriteHeader(http.StatusOK)
			json.NewEncoder(w).Encode(map[string]string{"status": "success"})
		}))
		defer server.Close()

		cc := &CloudClient{
			apiURL: server.URL,
			apiKey: "test-key",
			client: http.DefaultClient,
		}

		data := &ModemData{CheckTime: time.Now().Unix()}

		// Should retry and succeed
		err := cc.uploadToCloud(data, "XB8-TEST", "test.json")
		assert.NoError(t, err)
		assert.Equal(t, 2, attempts)
	})

	t.Run("Upload queue management", func(t *testing.T) {
		tmpDir := t.TempDir()
		queuePath := filepath.Join(tmpDir, ".upload_queue.json")

		// Create cloud client
		cc := &CloudClient{
			queueFile: queuePath,
		}

		// Add to queue
		entry := UploadQueueEntry{
			FilePath:      "/path/to/check.json",
			ModemID:       "XB8-TEST",
			Attempts:      1,
			LastError:     "Connection timeout",
			FirstFailure:  time.Now().Unix(),
		}

		err := cc.addToUploadQueue(entry)
		require.NoError(t, err)

		// Read queue
		queue, err := cc.loadUploadQueue()
		require.NoError(t, err)
		assert.Len(t, queue, 1)
		assert.Equal(t, "XB8-TEST", queue[0].ModemID)
	})
}

func TestPrivateNetworkDetection(t *testing.T) {
	tests := []struct {
		ip        string
		isPrivate bool
	}{
		{"192.168.1.1", true},
		{"10.0.0.1", true},
		{"172.16.0.1", true},
		{"172.31.255.255", true},
		{"8.8.8.8", false},
		{"1.1.1.1", false},
		{"172.32.0.1", false}, // Outside private range
		{"", true},            // Empty = private
	}

	for _, tt := range tests {
		t.Run(tt.ip, func(t *testing.T) {
			result := isPrivateNetwork(tt.ip)
			assert.Equal(t, tt.isPrivate, result)
		})
	}
}

func TestVersionComparison(t *testing.T) {
	tests := []struct {
		current      string
		latest       string
		shouldUpdate bool
	}{
		{"5.0.0", "6.0.0", true},
		{"6.0.0", "6.0.0", false},
		{"6.0.0", "5.9.0", false},
		{"6.0.0-beta", "6.0.0", true},
		{"6.0.0", "6.0.1", true},
		{"6.0.0-test.1", "6.0.0-test.2", true},
	}

	for _, tt := range tests {
		t.Run(fmt.Sprintf("%s vs %s", tt.current, tt.latest), func(t *testing.T) {
			result, err := shouldUpdateVersion(tt.current, tt.latest)
			require.NoError(t, err)
			assert.Equal(t, tt.shouldUpdate, result)
		})
	}
}

func TestErrorHandling(t *testing.T) {
	t.Run("HTTP response body closing", func(t *testing.T) {
		// Test that all HTTP responses properly close body
		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			w.Write([]byte("test response"))
		}))
		defer server.Close()

		resp, err := http.Get(server.URL)
		require.NoError(t, err)

		// Should always close body
		defer resp.Body.Close()

		// Read body
		body, err := io.ReadAll(resp.Body)
		require.NoError(t, err)
		assert.Equal(t, "test response", string(body))
	})

	t.Run("JSON marshaling errors", func(t *testing.T) {
		// Test handling of unmarshalable data
		type InvalidData struct {
			Channel chan int // Channels can't be marshaled to JSON
		}

		data := InvalidData{Channel: make(chan int)}
		_, err := json.Marshal(data)
		assert.Error(t, err)
	})

	t.Run("File operation errors", func(t *testing.T) {
		// Test handling of file permission errors
		tmpDir := t.TempDir()
		readOnlyFile := filepath.Join(tmpDir, "readonly.txt")

		// Create read-only file
		err := os.WriteFile(readOnlyFile, []byte("test"), 0444)
		require.NoError(t, err)

		// Try to write to read-only file
		err = os.WriteFile(readOnlyFile, []byte("new content"), 0644)
		assert.Error(t, err)
	})
}

func TestConcurrentOperations(t *testing.T) {
	t.Run("Concurrent log writes", func(t *testing.T) {
		tmpDir := t.TempDir()
		logPath := filepath.Join(tmpDir, "concurrent.log")

		mc := &ModemCheck{
			logFilePath: logPath,
		}

		// Initialize log file
		logFile, err := os.OpenFile(logPath, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0644)
		require.NoError(t, err)
		mc.logFile = logFile
		defer logFile.Close()

		// Write concurrently (mutex should prevent corruption)
		done := make(chan bool, 10)
		for i := 0; i < 10; i++ {
			go func(n int) {
				mc.Log(fmt.Sprintf("Log entry %d", n))
				done <- true
			}(i)
		}

		// Wait for all goroutines
		for i := 0; i < 10; i++ {
			<-done
		}

		// Verify all entries were written
		content, err := os.ReadFile(logPath)
		require.NoError(t, err)

		for i := 0; i < 10; i++ {
			assert.Contains(t, string(content), fmt.Sprintf("Log entry %d", i))
		}
	})
}

// Helper function for version comparison (mock)
func shouldUpdateVersion(current, latest string) (bool, error) {
	// Simple comparison for testing
	return current < latest, nil
}