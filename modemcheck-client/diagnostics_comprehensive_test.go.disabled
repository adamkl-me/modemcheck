func TestSpeedTestExecution(t *testing.T) {
	tests := []struct {
		name           string
		interval       int
		runCount       int
		lastRun        int
		lastSuccess    bool
		shouldRun      bool
		expectedResult float64
	}{
		{
			name:           "Run on interval",
			interval:       3,
			runCount:       6,
			lastRun:        3,
			lastSuccess:    true,
			shouldRun:      true,
			expectedResult: 950.5,
		},
		{
			name:           "Skip - not on interval",
			interval:       5,
			runCount:       7,
			lastRun:        5,
			lastSuccess:    true,
			shouldRun:      false,
			expectedResult: -2, // Skipped
		},
		{
			name:           "Retry after failure",
			interval:       10,
			runCount:       11,
			lastRun:        10,
			lastSuccess:    false,
			shouldRun:      true, // Retry on failure
			expectedResult: 850.3,
		},
		{
			name:           "First run",
			interval:       1,
			runCount:       1,
			lastRun:        0,
			lastSuccess:    false,
			shouldRun:      true,
			expectedResult: 750.2,
		},
		{
			name:           "Disabled",
			interval:       0,
			runCount:       100,
			lastRun:        0,
			lastSuccess:    false,
			shouldRun:      false,
			expectedResult: -1, // Disabled
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			state := SpeedTestState{
				RunCount:        tt.runCount,
				LastSpeedTest:   tt.lastRun,
				LastTestSuccess: tt.lastSuccess,
			}

			shouldRun := shouldRunSpeedTest(tt.interval, &state)
			assert.Equal(t, tt.shouldRun, shouldRun)
		})
	}
}

func TestIPDetectionFallback(t *testing.T) {
	t.Run("All services working", func(t *testing.T) {
		// Create mock servers
		primary := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			json.NewEncoder(w).Encode(map[string]interface{}{
				"ip":      "1.2.3.4",
				"org":     "Test ISP",
				"asn":     "AS12345",
				"city":    "TestCity",
				"country": "TestCountry",
			})
		}))
		defer primary.Close()

		// Test IP detection
		info, err := detectPublicIP(primary.URL, "", "")
		require.NoError(t, err)

		assert.Equal(t, "1.2.3.4", info.IP)
		assert.Equal(t, "Test ISP", info.ISP)
		assert.Equal(t, "AS12345", info.ASN)
		assert.Equal(t, "primary_service", info.DetectionStatus)
	})

	t.Run("Primary fails, secondary works", func(t *testing.T) {
		// Primary returns error
		primary := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			w.WriteHeader(http.StatusInternalServerError)
		}))
		defer primary.Close()

		// Secondary works
		secondary := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			json.NewEncoder(w).Encode(map[string]interface{}{
				"query": "2.3.4.5",
				"isp":   "Backup ISP",
				"as":    "AS54321",
			})
		}))
		defer secondary.Close()

		info, err := detectPublicIP(primary.URL, secondary.URL, "")
		require.NoError(t, err)

		assert.Equal(t, "2.3.4.5", info.IP)
		assert.Equal(t, "Backup ISP", info.ISP)
		assert.Equal(t, "secondary_service", info.DetectionStatus)
	})

	t.Run("Primary and secondary fail, tertiary works", func(t *testing.T) {
		// Primary and secondary fail
		primary := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			w.WriteHeader(http.StatusInternalServerError)
		}))
		defer primary.Close()

		secondary := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			w.WriteHeader(http.StatusInternalServerError)
		}))
		defer secondary.Close()

		// Tertiary returns IP only
		tertiary := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			w.Write([]byte("3.4.5.6"))
		}))
		defer tertiary.Close()

		info, err := detectPublicIP(primary.URL, secondary.URL, tertiary.URL)
		require.NoError(t, err)

		assert.Equal(t, "3.4.5.6", info.IP)
		assert.Equal(t, "", info.ISP) // No ISP from tertiary
		assert.Equal(t, "tertiary_service", info.DetectionStatus)
	})

	t.Run("All services fail", func(t *testing.T) {
		// All services return errors
		primary := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			w.WriteHeader(http.StatusInternalServerError)
		}))
		defer primary.Close()

		secondary := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			w.WriteHeader(http.StatusInternalServerError)
		}))
		defer secondary.Close()

		tertiary := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			w.WriteHeader(http.StatusInternalServerError)
		}))
		defer tertiary.Close()

		info, err := detectPublicIP(primary.URL, secondary.URL, tertiary.URL)
		require.NoError(t, err) // Should not error, returns empty data

		assert.Equal(t, "", info.IP)
		assert.Equal(t, "all_failed", info.DetectionStatus)
	})

	t.Run("Rate limiting handling", func(t *testing.T) {
		attempts := 0

		// Primary rate limits on first attempt
		primary := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			attempts++
			if attempts == 1 {
				w.WriteHeader(http.StatusTooManyRequests)
				return
			}
			json.NewEncoder(w).Encode(map[string]interface{}{
				"ip": "4.5.6.7",
			})
		}))
		defer primary.Close()

		// Should fallback to secondary
		secondary := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			json.NewEncoder(w).Encode(map[string]interface{}{
				"query": "5.6.7.8",
			})
		}))
		defer secondary.Close()

		info, err := detectPublicIP(primary.URL, secondary.URL, "")
		require.NoError(t, err)

		assert.Equal(t, "5.6.7.8", info.IP)
	})
}

func TestPingTests(t *testing.T) {
	t.Run("Successful ping results", func(t *testing.T) {
		result := runPingTests()

		// Should have both Google and Cloudflare results
		assert.NotNil(t, result.GoogleDNS)
		assert.NotNil(t, result.CloudflareDNS)

		// Results should have required fields
		if result.GoogleDNS.AvgLatency != "" {
			assert.Contains(t, result.GoogleDNS.AvgLatency, ".")
			assert.NotEmpty(t, result.GoogleDNS.PacketLoss)
		}
	})

	t.Run("Ping with timeout", func(t *testing.T) {
		// Test timeout handling
		start := time.Now()
		result := runPingTestWithTimeout("192.0.2.1", 1) // Test IP (won't route)
		duration := time.Since(start)

		// Should timeout within reasonable time
		assert.Less(t, duration, 3*time.Second)

		// Should have empty or error result
		if result.AvgLatency == "" {
			assert.Equal(t, "", result.PacketLoss)
		}
	})

	t.Run("Concurrent ping execution", func(t *testing.T) {
		// Test that pings run concurrently
		start := time.Now()
		result := runPingTests()
		duration := time.Since(start)

		// Both pings should complete faster than sequential
		assert.Less(t, duration, 5*time.Second)
		assert.NotNil(t, result)
	})
}

func TestIperfSpeedTest(t *testing.T) {
	t.Run("Iperf3 server connection", func(t *testing.T) {
		// Create mock iperf server
		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			// Mock iperf3 JSON output
			result := map[string]interface{}{
				"end": map[string]interface{}{
					"sum_sent": map[string]interface{}{
						"bits_per_second": 950000000, // 950 Mbps
					},
					"sum_received": map[string]interface{}{
						"bits_per_second": 40000000, // 40 Mbps
					},
				},
			}
			json.NewEncoder(w).Encode(result)
		}))
		defer server.Close()

		// Test would connect to actual iperf3 server
		// This is a mock for testing
	})

	t.Run("Iperf3 error handling", func(t *testing.T) {
		// Test handling of iperf3 failures
		result := runIperf3Test("invalid-server", 5201)

		// Should return -1 for failures
		assert.Equal(t, float64(-1), result.Download)
		assert.Equal(t, float64(-1), result.Upload)
	})
}

func TestSpeedTestDotNet(t *testing.T) {
	t.Run("Speedtest.net execution", func(t *testing.T) {
		// This would test actual speedtest-cli execution
		// Mocked for unit testing
		result := SpeedTestData{
			Download:   850.5,
			Upload:     35.2,
			Latency:    12.5,
			Jitter:     2.1,
			PacketLoss: 0.0,
			Server:     "Test Server",
			ISP:        "Test ISP",
		}

		assert.Greater(t, result.Download, 0.0)
		assert.Greater(t, result.Upload, 0.0)
		assert.Greater(t, result.Latency, 0.0)
	})

	t.Run("Speedtest binary detection", func(t *testing.T) {
		// Check if speedtest binary exists
		exists := checkSpeedtestBinary()

		// Test should handle both cases
		if exists {
			// Can run speedtest
			result := runSpeedtestDotNet()
			assert.NotNil(t, result)
		} else {
			// Should return empty result
			result := runSpeedtestDotNet()
			assert.Equal(t, float64(-1), result.Download)
		}
	})
}

func TestNetworkInterfaceInfo(t *testing.T) {
	t.Run("Get network interfaces", func(t *testing.T) {
		interfaces, err := getNetworkInterfaces()
		require.NoError(t, err)

		// Should have at least loopback
		assert.NotEmpty(t, interfaces)

		// Check interface properties
		for _, iface := range interfaces {
			assert.NotEmpty(t, iface.Name)
			if iface.Name == "lo" || iface.Name == "lo0" {
				assert.Contains(t, iface.Addresses, "127.0.0.1")
			}
		}
	})

	t.Run("Get default gateway", func(t *testing.T) {
		gateway := getDefaultGateway()

		// May be empty in some test environments
		if gateway != "" {
			// Should be valid IP
			assert.Regexp(t, `^\d+\.\d+\.\d+\.\d+$`, gateway)
		}
	})

	t.Run("Get DNS servers", func(t *testing.T) {
		servers := getDNSServers()

		// Should have at least one DNS server in most environments
		if len(servers) > 0 {
			for _, server := range servers {
				// Should be valid IP
				assert.Regexp(t, `^\d+\.\d+\.\d+\.\d+$`, server)
			}
		}
	})
}

func TestHTTPClientReuse(t *testing.T) {
	t.Run("Client connection pooling", func(t *testing.T) {
		requestCount := 0

		// Create test server
		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			requestCount++
			w.Write([]byte(fmt.Sprintf("Request %d", requestCount)))
		}))
		defer server.Close()

		// Make multiple requests with same client
		client := createHTTPClient()

		for i := 0; i < 5; i++ {
			resp, err := client.Get(server.URL)
			require.NoError(t, err)
			resp.Body.Close()
		}

		// All requests should succeed
		assert.Equal(t, 5, requestCount)
	})

	t.Run("Client timeout handling", func(t *testing.T) {
		// Create slow server
		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			time.Sleep(5 * time.Second)
			w.Write([]byte("slow response"))
		}))
		defer server.Close()

		// Client with short timeout
		client := &http.Client{
			Timeout: 1 * time.Second,
		}

		// Should timeout
		_, err := client.Get(server.URL)
		assert.Error(t, err)
		assert.Contains(t, err.Error(), "timeout")
	})
}

func TestDiagnosticsConcurrency(t *testing.T) {
	t.Run("Concurrent diagnostic operations", func(t *testing.T) {
		// Run multiple diagnostics concurrently
		done := make(chan bool, 3)

		// IP detection
		go func() {
			info, _ := detectPublicIP("", "", "")
			assert.NotNil(t, info)
			done <- true
		}()

		// Ping tests
		go func() {
			result := runPingTests()
			assert.NotNil(t, result)
			done <- true
		}()

		// Network interfaces
		go func() {
			interfaces, _ := getNetworkInterfaces()
			assert.NotNil(t, interfaces)
			done <- true
		}()

		// Wait for all to complete
		for i := 0; i < 3; i++ {
			select {
			case <-done:
				// Success
			case <-time.After(10 * time.Second):
				t.Fatal("Timeout waiting for concurrent operations")
			}
		}
	})
}

func TestDiagnosticsErrorRecovery(t *testing.T) {
	t.Run("Recover from panic in goroutine", func(t *testing.T) {
		// Test panic recovery in ping goroutines
		recovered := false

		func() {
			defer func() {
				if r := recover(); r != nil {
					recovered = true
				}
			}()

			// Simulate panic in goroutine
			go func() {
				defer func() {
					recover()
				}()
				panic("test panic")
			}()

			time.Sleep(100 * time.Millisecond)
		}()

		// Should not crash the program
		assert.False(t, recovered, "Main thread should not panic")
	})

	t.Run("Handle malformed JSON responses", func(t *testing.T) {
		// Create server with invalid JSON
		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			w.Write([]byte("{invalid json}"))
		}))
		defer server.Close()

		// Should handle gracefully
		info, err := fetchJSONFromService(server.URL, "test")
		assert.Error(t, err)
		assert.Nil(t, info)
	})
}

// Helper functions for testing
func shouldRunSpeedTest(interval int, state *SpeedTestState) bool {
	if interval == 0 {
		return false
	}
	if interval == 1 {
		return true
	}
	if !state.LastTestSuccess && state.LastSpeedTest > 0 {
		return true // Retry on failure
	}
	return state.RunCount%interval == 0
}

