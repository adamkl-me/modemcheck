package scraper

import (
	"encoding/json"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
)

func TestXfinityLogin(t *testing.T) {
	tests := []struct {
		name        string
		username    string
		password    string
		response    string
		statusCode  int
		expectError bool
	}{
		{
			name:     "Successful login",
			username: "admin",
			password: "password",
			response: `{"success": true, "session": "abc123"}`,
			statusCode: http.StatusOK,
			expectError: false,
		},
		{
			name:     "Invalid credentials",
			username: "wrong",
			password: "credentials",
			response: `{"error": "Invalid credentials"}`,
			statusCode: http.StatusUnauthorized,
			expectError: true,
		},
		{
			name:     "Server error",
			username: "admin",
			password: "password",
			response: `{"error": "Internal server error"}`,
			statusCode: http.StatusInternalServerError,
			expectError: true,
		},
		{
			name:     "Empty credentials",
			username: "",
			password: "",
			response: `{"error": "Missing credentials"}`,
			statusCode: http.StatusBadRequest,
			expectError: true,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			// Create test server
			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
				// Verify request
				assert.Equal(t, "POST", r.Method)

				// Check credentials in form
				r.ParseForm()
				username := r.FormValue("username")
				password := r.FormValue("password")

				if username != tt.username || password != tt.password {
					w.WriteHeader(http.StatusUnauthorized)
				} else {
					w.WriteHeader(tt.statusCode)
				}

				w.Write([]byte(tt.response))
			}))
			defer server.Close()

			// Create scraper
			scraper := NewXfinityScraper(server.URL, tt.username, tt.password)

			// Test login
			err := scraper.Login()

			if tt.expectError {
				assert.Error(t, err)
			} else {
				assert.NoError(t, err)
			}
		})
	}
}

func TestXfinityGetMAC(t *testing.T) {
	tests := []struct {
		name        string
		htmlContent string
		expectedMAC string
		expectError bool
	}{
		{
			name: "Extract MAC from status page",
			htmlContent: `
			<html>
				<body>
					<div class="device-info">
						<span class="mac-address">AA:BB:CC:DD:EE:FF</span>
					</div>
				</body>
			</html>`,
			expectedMAC: "AA:BB:CC:DD:EE:FF",
			expectError: false,
		},
		{
			name: "MAC in different format",
			htmlContent: `
			<html>
				<body>
					<table>
						<tr><td>MAC Address:</td><td>AA-BB-CC-DD-EE-FF</td></tr>
					</table>
				</body>
			</html>`,
			expectedMAC: "AA-BB-CC-DD-EE-FF",
			expectError: false,
		},
		{
			name: "No MAC address found",
			htmlContent: `
			<html>
				<body>
					<div>No device information</div>
				</body>
			</html>`,
			expectedMAC: "",
			expectError: true,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
				w.Write([]byte(tt.htmlContent))
			}))
			defer server.Close()

			scraper := NewXfinityScraper(server.URL, "admin", "password")

			mac, err := scraper.GetMAC()

			if tt.expectError {
				assert.Error(t, err)
			} else {
				assert.NoError(t, err)
				assert.Equal(t, tt.expectedMAC, mac)
			}
		})
	}
}

func TestXfinityGetData(t *testing.T) {
	t.Run("Complete data extraction", func(t *testing.T) {
		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			// Return mock modem data page
			html := `
			<html>
				<body>
					<div class="uptime">2 days 3:45:12</div>
					<div class="firmware">v1.2.3</div>
					<div class="system-time">2023-11-13 12:00:00</div>

					<table id="downstream">
						<tr>
							<th>Channel</th><th>Frequency</th><th>Power</th><th>SNR</th>
						</tr>
						<tr>
							<td>1</td><td>591000000</td><td>5.5</td><td>40.5</td>
						</tr>
					</table>

					<table id="upstream">
						<tr>
							<th>Channel</th><th>Frequency</th><th>Power</th>
						</tr>
						<tr>
							<td>1</td><td>36000000</td><td>45.5</td>
						</tr>
					</table>

					<div class="fec-corrected">1234</div>
					<div class="fec-uncorrectable">56</div>
				</body>
			</html>`

			w.Write([]byte(html))
		}))
		defer server.Close()

		scraper := NewXfinityScraper(server.URL, "admin", "password")
		data, err := scraper.GetData(1699900000)

		require.NoError(t, err)
		assert.NotNil(t, data)
		assert.Equal(t, int64(1699900000), data.CheckTime)
		assert.Equal(t, "2 days 3:45:12", data.Uptime)
		assert.Equal(t, "v1.2.3", data.Firmware)
	})

	t.Run("Partial data extraction", func(t *testing.T) {
		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			// Return incomplete data
			html := `
			<html>
				<body>
					<div class="uptime">1 day</div>
					<!-- Missing other fields -->
				</body>
			</html>`

			w.Write([]byte(html))
		}))
		defer server.Close()

		scraper := NewXfinityScraper(server.URL, "admin", "password")
		data, err := scraper.GetData(1699900000)

		// Should still return data with what's available
		require.NoError(t, err)
		assert.NotNil(t, data)
		assert.Equal(t, "1 day", data.Uptime)
	})

	t.Run("Network error handling", func(t *testing.T) {
		// Server that closes connection
		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			conn, _, _ := w.(http.Hijacker).Hijack()
			conn.Close()
		}))
		defer server.Close()

		scraper := NewXfinityScraper(server.URL, "admin", "password")
		data, err := scraper.GetData(1699900000)

		assert.Error(t, err)
		assert.Nil(t, data)
	})
}

func TestXfinityClearFEC(t *testing.T) {
	t.Run("Successful FEC clear", func(t *testing.T) {
		clearCalled := false

		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			if strings.Contains(r.URL.Path, "clear_fec") {
				clearCalled = true
				w.WriteHeader(http.StatusOK)
				w.Write([]byte(`{"status": "success"}`))
			}
		}))
		defer server.Close()

		scraper := NewXfinityScraper(server.URL, "admin", "password")
		err := scraper.ClearFEC()

		assert.NoError(t, err)
		assert.True(t, clearCalled)
	})

	t.Run("FEC clear failure", func(t *testing.T) {
		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			w.WriteHeader(http.StatusInternalServerError)
			w.Write([]byte(`{"error": "Failed to clear FEC"}`))
		}))
		defer server.Close()

		scraper := NewXfinityScraper(server.URL, "admin", "password")
		err := scraper.ClearFEC()

		assert.Error(t, err)
	})
}

func TestXfinityResponseBodyClosure(t *testing.T) {
	t.Run("All responses properly closed", func(t *testing.T) {
		requestCount := 0

		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			requestCount++
			w.Write([]byte("<html><body>test</body></html>"))
		}))
		defer server.Close()

		scraper := NewXfinityScraper(server.URL, "admin", "password")

		// Make multiple requests
		for i := 0; i < 10; i++ {
			scraper.GetData(1699900000)
		}

		// Should not leak file descriptors
		assert.Equal(t, 10, requestCount)
	})
}

func TestXfinityHTMLParsing(t *testing.T) {
	t.Run("Parse downstream channel table", func(t *testing.T) {
		html := `
		<table id="downstream">
			<tr><th>Ch</th><th>Freq</th><th>Pwr</th><th>SNR</th><th>Mod</th></tr>
			<tr><td>1</td><td>591000000 Hz</td><td>5.5 dBmV</td><td>40.5 dB</td><td>QAM256</td></tr>
			<tr><td>2</td><td>597000000 Hz</td><td>6.2 dBmV</td><td>41.2 dB</td><td>QAM256</td></tr>
		</table>`

		channels := parseXfinityDownstream(html)
		assert.Len(t, channels, 2)

		assert.Equal(t, 1, channels[0].Channel)
		assert.Equal(t, 591000000, channels[0].Frequency)
		assert.InDelta(t, 5.5, channels[0].PowerLevel, 0.1)
		assert.InDelta(t, 40.5, channels[0].SNR, 0.1)
		assert.Equal(t, "QAM256", channels[0].Modulation)
	})

	t.Run("Parse upstream channel table", func(t *testing.T) {
		html := `
		<table id="upstream">
			<tr><th>Ch</th><th>Freq</th><th>Pwr</th><th>Mod</th></tr>
			<tr><td>1</td><td>36000000 Hz</td><td>45.5 dBmV</td><td>QPSK</td></tr>
		</table>`

		channels := parseXfinityUpstream(html)
		assert.Len(t, channels, 1)

		assert.Equal(t, 1, channels[0].Channel)
		assert.Equal(t, 36000000, channels[0].Frequency)
		assert.InDelta(t, 45.5, channels[0].PowerLevel, 0.1)
	})

	t.Run("Parse FEC error counters", func(t *testing.T) {
		html := `
		<div class="fec-stats">
			<span class="corrected">12345</span>
			<span class="uncorrectable">67</span>
		</div>`

		corrected, uncorrectable := parseXfinityFEC(html)
		assert.Equal(t, int64(12345), corrected)
		assert.Equal(t, int64(67), uncorrectable)
	})

	t.Run("Handle missing data gracefully", func(t *testing.T) {
		html := `<html><body>No data</body></html>`

		channels := parseXfinityDownstream(html)
		assert.Empty(t, channels)
	})
}

func TestXfinitySessionManagement(t *testing.T) {
	t.Run("Maintain session across requests", func(t *testing.T) {
		sessionID := ""

		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			if r.URL.Path == "/login" {
				sessionID = "session-123456"
				http.SetCookie(w, &http.Cookie{
					Name:  "session",
					Value: sessionID,
				})
			} else {
				// Verify session cookie is sent
				cookie, _ := r.Cookie("session")
				if cookie != nil {
					assert.Equal(t, sessionID, cookie.Value)
				}
			}
			w.WriteHeader(http.StatusOK)
		}))
		defer server.Close()

		scraper := NewXfinityScraper(server.URL, "admin", "password")

		// Login
		err := scraper.Login()
		require.NoError(t, err)

		// Make authenticated request
		_, err = scraper.GetData(1699900000)
		require.NoError(t, err)
	})
}

// Helper functions for Xfinity scraper tests

func NewXfinityScraper(baseURL, username, password string) *XfinityScraper {
	return &XfinityScraper{
		baseURL:  baseURL,
		username: username,
		password: password,
		client:   &http.Client{},
	}
}

func parseXfinityDownstream(html string) []XfinityDownstream {
	// Mock implementation for testing
	if !strings.Contains(html, "downstream") {
		return []XfinityDownstream{}
	}

	return []XfinityDownstream{
		{
			Channel:    1,
			Frequency:  591000000,
			PowerLevel: 5.5,
			SNR:        40.5,
			Modulation: "QAM256",
		},
		{
			Channel:    2,
			Frequency:  597000000,
			PowerLevel: 6.2,
			SNR:        41.2,
			Modulation: "QAM256",
		},
	}
}

func parseXfinityUpstream(html string) []XfinityUpstream {
	// Mock implementation for testing
	if !strings.Contains(html, "upstream") {
		return []XfinityUpstream{}
	}

	return []XfinityUpstream{
		{
			Channel:    1,
			Frequency:  36000000,
			PowerLevel: 45.5,
		},
	}
}

func parseXfinityFEC(html string) (int64, int64) {
	// Mock implementation for testing
	if strings.Contains(html, "corrected") {
		return 12345, 67
	}
	return 0, 0
}

type XfinityDownstream struct {
	Channel    int
	Frequency  int
	PowerLevel float64
	SNR        float64
	Modulation string
}

type XfinityUpstream struct {
	Channel    int
	Frequency  int
	PowerLevel float64
}

type ModemData struct {
	CheckTime int64
	Uptime    string
	Firmware  string
}