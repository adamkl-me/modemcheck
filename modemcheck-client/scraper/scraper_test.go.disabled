	})

	t.Run("No modem found", func(t *testing.T) {
		// All IPs fail - should return nil
		// Mock implementation for testing
	})
}

func TestScraperInterface(t *testing.T) {
	t.Run("Interface contract", func(t *testing.T) {
		// Test that all scrapers implement the interface
		var _ ModemScraper = (*XfinityScraper)(nil)
		var _ ModemScraper = (*CodaScraper)(nil)
		var _ ModemScraper = (*DM1000Scraper)(nil)
	})

	t.Run("GetModemType returns correct value", func(t *testing.T) {
		scrapers := []struct {
			scraper      ModemScraper
			expectedType string
		}{
			{&XfinityScraper{}, "Xfinity XB8"},
			{&CodaScraper{}, "CODA"},
			{&DM1000Scraper{}, "DM1000"},
		}

		for _, s := range scrapers {
			assert.Equal(t, s.expectedType, s.scraper.GetModemType())
		}
	})
}

func TestStateFilePersistence(t *testing.T) {
	t.Run("Save and load last successful modem", func(t *testing.T) {
		tmpDir := t.TempDir()
		statePath := tmpDir + "/last_successful_modem.json"

		// Save state
		state := LastModemState{
			ModemType: "XB8",
			MAC:       "AA:BB:CC:DD:EE:FF",
			IP:        "192.168.100.1",
			Timestamp: 1699900000,
		}

		err := saveModemState(statePath, &state)
		require.NoError(t, err)

		// Load state
		loaded, err := loadModemState(statePath)
		require.NoError(t, err)

		assert.Equal(t, state.ModemType, loaded.ModemType)
		assert.Equal(t, state.MAC, loaded.MAC)
		assert.Equal(t, state.IP, loaded.IP)
		assert.Equal(t, state.Timestamp, loaded.Timestamp)
	})

	t.Run("Handle missing state file", func(t *testing.T) {
		tmpDir := t.TempDir()
		statePath := tmpDir + "/nonexistent.json"

		// Should return nil without error for missing file
		loaded, err := loadModemState(statePath)
		assert.NoError(t, err)
		assert.Nil(t, loaded)
	})

	t.Run("Handle corrupted state file", func(t *testing.T) {
		tmpDir := t.TempDir()
		statePath := tmpDir + "/corrupted.json"

		// Write invalid JSON
		err := os.WriteFile(statePath, []byte("{invalid json}"), 0644)
		require.NoError(t, err)

		// Should handle gracefully
		loaded, err := loadModemState(statePath)
		assert.Error(t, err)
		assert.Nil(t, loaded)
	})
}

func TestHTTPClientConfiguration(t *testing.T) {
	t.Run("Cookie jar creation", func(t *testing.T) {
		client := createScraperHTTPClient()
		require.NotNil(t, client)
		require.NotNil(t, client.Jar)
	})

	t.Run("Timeout configuration", func(t *testing.T) {
		client := createScraperHTTPClient()
		assert.Equal(t, 30*time.Second, client.Timeout)
	})

	t.Run("TLS configuration", func(t *testing.T) {
		client := createScraperHTTPClient()
		transport := client.Transport.(*http.Transport)

		// Should have reasonable TLS config for local modems
		assert.NotNil(t, transport.TLSClientConfig)
	})
}

func TestMACAddressExtraction(t *testing.T) {
	tests := []struct {
		name        string
		htmlContent string
		expectedMAC string
		shouldFind  bool
	}{
		{
			name:        "Standard MAC with colons",
			htmlContent: `<div>MAC Address: AA:BB:CC:DD:EE:FF</div>`,
			expectedMAC: "AA:BB:CC:DD:EE:FF",
			shouldFind:  true,
		},
		{
			name:        "MAC with dashes",
			htmlContent: `<span>AA-BB-CC-DD-EE-FF</span>`,
			expectedMAC: "AA-BB-CC-DD-EE-FF",
			shouldFind:  true,
		},
		{
			name:        "Lowercase MAC",
			htmlContent: `<p>aa:bb:cc:dd:ee:ff</p>`,
			expectedMAC: "aa:bb:cc:dd:ee:ff",
			shouldFind:  true,
		},
		{
			name:        "No MAC address",
			htmlContent: `<div>No MAC here</div>`,
			expectedMAC: "",
			shouldFind:  false,
		},
		{
			name:        "Invalid MAC format",
			htmlContent: `<div>ZZ:YY:XX:WW:VV:UU</div>`,
			expectedMAC: "",
			shouldFind:  false,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			mac := extractMACAddress(tt.htmlContent)

			if tt.shouldFind {
				assert.Equal(t, tt.expectedMAC, mac)
			} else {
				assert.Empty(t, mac)
			}
		})
	}
}

func TestChannelDataParsing(t *testing.T) {
	t.Run("Parse downstream channels", func(t *testing.T) {
		htmlTable := `
		<table>
			<tr>
				<th>Channel</th>
				<th>Frequency</th>
				<th>Power</th>
				<th>SNR</th>
			</tr>
			<tr>
				<td>1</td>
				<td>591000000</td>
				<td>5.5 dBmV</td>
				<td>40.5 dB</td>
			</tr>
			<tr>
				<td>2</td>
				<td>597000000</td>
				<td>6.2 dBmV</td>
				<td>41.2 dB</td>
			</tr>
		</table>
		`

		channels := parseDownstreamChannels(htmlTable)
		assert.Len(t, channels, 2)

		assert.Equal(t, 1, channels[0].Channel)
		assert.Equal(t, 591000000, channels[0].Frequency)
		assert.Equal(t, 5.5, channels[0].PowerLevel)
		assert.Equal(t, 40.5, channels[0].SNR)
	})

	t.Run("Parse upstream channels", func(t *testing.T) {
		htmlTable := `
		<table>
			<tr>
				<th>Channel</th>
				<th>Frequency</th>
				<th>Power</th>
			</tr>
			<tr>
				<td>1</td>
				<td>36000000</td>
				<td>45.5 dBmV</td>
			</tr>
		</table>
		`

		channels := parseUpstreamChannels(htmlTable)
		assert.Len(t, channels, 1)

		assert.Equal(t, 1, channels[0].Channel)
		assert.Equal(t, 36000000, channels[0].Frequency)
		assert.Equal(t, 45.5, channels[0].PowerLevel)
	})

	t.Run("Handle malformed table data", func(t *testing.T) {
		malformedHTML := `<table><tr><td>bad</td></tr></table>`

		channels := parseDownstreamChannels(malformedHTML)
		assert.Empty(t, channels)
	})
}

func TestFECErrorParsing(t *testing.T) {
	tests := []struct {
		name                string
		htmlContent         string
		expectedCorrected   int64
		expectedUncorrectable int64
	}{
		{
			name: "Parse FEC errors",
			htmlContent: `
			<div>
				<span>Corrected: 12345</span>
				<span>Uncorrectable: 67</span>
			</div>
			`,
			expectedCorrected:   12345,
			expectedUncorrectable: 67,
		},
		{
			name: "No errors",
			htmlContent: `
			<div>
				<span>Corrected: 0</span>
				<span>Uncorrectable: 0</span>
			</div>
			`,
			expectedCorrected:   0,
			expectedUncorrectable: 0,
		},
		{
			name:                "Missing error data",
			htmlContent:         `<div>No error information</div>`,
			expectedCorrected:   0,
			expectedUncorrectable: 0,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			corrected, uncorrectable := parseFECErrors(tt.htmlContent)

			assert.Equal(t, tt.expectedCorrected, corrected)
			assert.Equal(t, tt.expectedUncorrectable, uncorrectable)
		})
	}
}

func TestLoginErrorHandling(t *testing.T) {
	t.Run("Handle authentication failure", func(t *testing.T) {
		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			w.WriteHeader(http.StatusUnauthorized)
			w.Write([]byte("Invalid credentials"))
		}))
		defer server.Close()

		scraper := &XfinityScraper{
			baseURL:  server.URL,
			username: "wrong",
			password: "credentials",
		}

		err := scraper.Login()
		assert.Error(t, err)
		assert.Contains(t, err.Error(), "authentication")
	})

	t.Run("Handle network timeout", func(t *testing.T) {
		// Server that never responds
		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			time.Sleep(10 * time.Second)
		}))
		defer server.Close()

		scraper := &XfinityScraper{
			baseURL: server.URL,
			client: &http.Client{
				Timeout: 1 * time.Second,
			},
		}

		err := scraper.Login()
		assert.Error(t, err)
	})

	t.Run("Handle malformed response", func(t *testing.T) {
		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			w.Write([]byte("malformed html<"))
		}))
		defer server.Close()

		scraper := &XfinityScraper{
			baseURL: server.URL,
		}

		// Should handle gracefully
		err := scraper.Login()
		assert.Error(t, err)
	})
}

func TestResponseBodyLeakPrevention(t *testing.T) {
	t.Run("All HTTP responses closed", func(t *testing.T) {
		callCount := 0

		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			callCount++
			w.Write([]byte("test response"))
		}))
		defer server.Close()

		// Make multiple requests
		scraper := &XfinityScraper{
			baseURL: server.URL,
			client:  http.DefaultClient,
		}

		for i := 0; i < 100; i++ {
			// Each request should properly close body
			_ = scraper.Login()
		}

		// Should not leak file descriptors
		assert.Equal(t, 100, callCount)
	})
}

// Helper functions and types for testing

type LastModemState struct {
	ModemType string
	MAC       string
	IP        string
	Timestamp int64
}

func DetectModem(html string) (string, string) {
	// Mock implementation
	if contains(html, "XB8") || contains(html, "Xfinity") {
		return "xfinity", "XB8"
	}
	if contains(html, "CODA") {
		return "coda", "CODA-4582"
	}
	if contains(html, "DM1000") {
		return "dm1000", "DM1000"
	}
	return "", ""
}

func saveModemState(path string, state *LastModemState) error {
	data, err := json.Marshal(state)
	if err != nil {
		return err
	}
	return os.WriteFile(path, data, 0644)
}

func loadModemState(path string) (*LastModemState, error) {
	data, err := os.ReadFile(path)
	if err != nil {
		if os.IsNotExist(err) {
			return nil, nil
		}
		return nil, err
	}

	var state LastModemState
	err = json.Unmarshal(data, &state)
	if err != nil {
		return nil, err
	}

	return &state, nil
}

func createScraperHTTPClient() *http.Client {
	return &http.Client{
		Timeout: 30 * time.Second,
		Transport: &http.Transport{
			TLSClientConfig: &tls.Config{InsecureSkipVerify: true},
		},
	}
}

func extractMACAddress(html string) string {
	// Simple MAC regex for testing
	re := regexp.MustCompile(`([0-9A-Fa-f]{2}[:-]){5}([0-9A-Fa-f]{2})`)
	match := re.FindString(html)
	return match
}

func parseDownstreamChannels(html string) []DownstreamChannel {
	// Mock implementation
	return []DownstreamChannel{}
}

func parseUpstreamChannels(html string) []UpstreamChannel {
	// Mock implementation
	return []UpstreamChannel{}
}

func parseFECErrors(html string) (int64, int64) {
	// Mock implementation
	return 0, 0
}

func contains(s, substr string) bool {
	return len(s) > 0 && len(substr) > 0 &&
		(s == substr || len(s) > len(substr) &&
		(s[:len(substr)] == substr || s[len(s)-len(substr):] == substr ||
		len(s) > len(substr)*2))
}

