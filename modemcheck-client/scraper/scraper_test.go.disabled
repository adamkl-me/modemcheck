func TestModemDetection(t *testing.T) {
	tests := []struct {
		name           string
		htmlContent    string
		expectedType   string
		expectedModel  string
		shouldDetect   bool
	}{
		{
			name: "Detect XB8 (Xfinity)",
			htmlContent: `<!DOCTYPE html>
<html>
<head><title>Xfinity Gateway</title></head>
<body>
<div class="model">XB8</div>
<div class="vendor">Arris</div>
</body>
</html>`,
			expectedType:  "xfinity",
			expectedModel: "XB8",
			shouldDetect:  true,
		},
		{
			name: "Detect CODA modem",
			htmlContent: `<!DOCTYPE html>
<html>
<head><title>CODA Cable Modem</title></head>
<body>
<h1>CODA-4582</h1>
</body>
</html>`,
			expectedType:  "coda",
			expectedModel: "CODA-4582",
			shouldDetect:  true,
		},
		{
			name: "Detect DM1000 modem",
			htmlContent: `<!DOCTYPE html>
<html>
<head><title>DM1000</title></head>
<body>
<div>Model: DM1000</div>
</body>
</html>`,
			expectedType:  "dm1000",
			expectedModel: "DM1000",
			shouldDetect:  true,
		},
		{
			name: "Unknown modem",
			htmlContent: `<!DOCTYPE html>
<html>
<head><title>Unknown Device</title></head>
<body>
<p>Generic router</p>
</body>
</html>`,
			expectedType:  "",
			expectedModel: "",
			shouldDetect:  false,
		},
		{
			name:          "Empty HTML",
			htmlContent:   "",
			expectedType:  "",
			expectedModel: "",
			shouldDetect:  false,
		},
		{
			name:          "Malformed HTML",
			htmlContent:   "<html><head><title>Test",
			expectedType:  "",
			expectedModel: "",
			shouldDetect:  false,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			// Create test server
			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
				w.Header().Set("Content-Type", "text/html")
				w.Write([]byte(tt.htmlContent))
			}))
			defer server.Close()

			// Test detection
			modemType, model := DetectModem(tt.htmlContent)

			if tt.shouldDetect {
				assert.Equal(t, tt.expectedType, modemType)
				assert.Equal(t, tt.expectedModel, model)
			} else {
				assert.Empty(t, modemType)
				assert.Empty(t, model)
			}
		})
	}
}

